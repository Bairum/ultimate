{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc-web",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite-plus/client"],
    "jsx": "react-jsx",
    "strict": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./web/src/*"] }
  },
  "include": [
    "web/src",
    "extensions/**/*.tsx",
    ".ultimate/extensions/**/*.tsx",
    "shared/protocol.ts",
    "extensions/conversations/types.ts",
    "extensions/workspaces/types.ts",
    "test/web"
  ]
}
