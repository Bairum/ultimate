{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ultimate-cloud",
  "main": "worker.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issue_detection": { "enabled": true }
  },
  "r2_buckets": [{ "binding": "BUILDS", "bucket_name": "ultimate-builds" }],
  "durable_objects": {
    "bindings": [
      { "name": "REPLICA", "class_name": "SharedReplica" },
      { "name": "DIRECTORY", "class_name": "ProjectDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Replica"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] },
    { "tag": "v3", "new_sqlite_classes": ["ProjectReplica"] },
    { "tag": "v4", "deleted_classes": ["Replica"] },
    { "tag": "v5", "new_sqlite_classes": ["SharedReplica", "ProjectDirectory"] },
    { "tag": "v6", "deleted_classes": ["Directory", "ProjectReplica"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api", "/api/*", "/sync", "/sync/*"]
  }
}
