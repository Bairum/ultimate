{
  "extensions": {
    "enable": [
      "automations",
      "canvas",
      "claude-code",
      "documents",
      "exclusive-commands",
      "info",
      "instance",
      "plan",
      "self",
      "subagents",
      "surfaces",
      "tasks",
      "clock"
    ],
    "disable": []
  },
  "exclusiveCommands": ["\\bpnpm( run)? test\\b", "\\bvp test\\b"],
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "githubTriage": {
    "writableRepos": ["HazAT/ultimate"]
  }
}
