{
  "extensions": {
    "enable": [
      "automations",
      "claude-code",
      "classify",
      "documents",
      "info",
      "instance",
      "phase",
      "plan",
      "self",
      "subagents",
      "surfaces",
      "tasks",
      "clock"
    ],
    "disable": []
  },
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "lander": {
    "checks": ["pnpm check", ["pnpm test", "pnpm test:e2e", "pnpm eval"]],
    "push": "origin"
  }
}
