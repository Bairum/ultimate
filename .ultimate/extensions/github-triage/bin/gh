#!/usr/bin/env node
// ultimate-gh-shim: other shims skip any gh that carries this marker, so two copies on PATH never call each other.
import { accessSync, constants, readFileSync, realpathSync } from 'node:fs'
import { dirname, join, resolve } from 'node:path'
import { spawnSync } from 'node:child_process'

const args = process.argv.slice(2)
// A shim started by a shim means a loop on PATH; refuse instead of forking until memory runs out.
if (process.env.ULTIMATE_GH_SHIM) {
  console.error('gh shim loop: refusing to run gh from inside another gh shim')
  process.exit(1)
}
const blocked = () => {
  console.error("Blocked: Ultimate's agent does not write to GitHub. Propose with triage_propose; the user applies it in the Triage surface.")
  process.exit(1)
}
const [command, subcommand] = args
let allowed = command === '--version' && args.length === 1
if (command === 'search') allowed = true
const reads = {
  auth: ['status'],
  issue: ['list', 'view', 'diff', 'checks', 'status'],
  pr: ['list', 'view', 'diff', 'checks', 'status'],
  label: ['list'],
  repo: ['view'],
  release: ['list', 'view'],
  run: ['list', 'view'],
}
if (reads[command]?.includes(subcommand)) allowed = true
if (command === 'api') {
  allowed = true
  for (let i = 1; i < args.length; i++) {
    const arg = args[i]
    if (/^(?:-[fF]|--(?:field|raw-field|input)(?:=|$))/.test(arg)) blocked()
    let method
    if (arg === '-X' || arg === '--method') method = args[++i] ?? ''
    else if (arg.startsWith('-X')) method = arg.slice(2)
    else if (arg.startsWith('--method=')) method = arg.slice(9)
    if (method !== undefined && method !== 'GET') blocked()
  }
}
if (!allowed) blocked()
const shim = realpathSync(process.argv[1])
const shimDir = dirname(shim)
let real
for (const directory of (process.env.PATH ?? '').split(':')) {
  if (resolve(directory) === shimDir) continue
  const candidate = join(directory || '.', 'gh')
  try {
    accessSync(candidate, constants.X_OK)
    if (realpathSync(candidate) === shim) continue
    if (readFileSync(candidate).subarray(0, 256).includes('ultimate-gh-shim')) continue
    real = candidate
    break
  } catch {}
}
if (!real) {
  console.error('gh is not installed on the original PATH')
  process.exit(1)
}
const result = spawnSync(real, args, {
  stdio: 'inherit',
  env: { ...process.env, ULTIMATE_GH_SHIM: '1' },
})
if (result.error) console.error(result.error.message)
process.exit(result.status ?? 1)
